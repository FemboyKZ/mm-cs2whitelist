import os

for sdk_target in MMSPlugin.sdk_targets:
    sdk = sdk_target.sdk
    cxx = sdk_target.cxx

    binary = MMSPlugin.HL2Library(
        builder, cxx, f'{MMSPlugin.metadata["name"]}.{sdk["name"]}', sdk
    )

    # Include paths
    binary.compiler.cxxincludes += [
        os.path.join(builder.sourcePath, "src"),
    ]

    binary.sources += [
        "src/cs2whitelist.cpp",
        "src/command/console_commands.cpp",
        "src/lang/translations.cpp",
        "src/player/player_manager.cpp",
        "src/steamgroup/steamgroup_manager.cpp",
        "src/whitelist/whitelist_manager.cpp",
        "src/utils/utils.cpp",
        "src/db/wl_config.cpp",
        "src/db/wl_database.cpp",
        "vendor/mm-utils/utils/chat_colors.cpp",
        "vendor/mm-utils/game/cvarquery.cpp",
        "vendor/mm-utils/utils/http_client.cpp",
        "vendor/mm-utils/utils/log.cpp",
        "vendor/mm-utils/sdk/sigscan.cpp",
        "vendor/mm-utils/utils/sql.cpp",
        "vendor/mm-utils/utils/translations.cpp",
    ]

    binary.custom = [
        builder.tools.Protoc(
            protoc=sdk_target.protoc,
            sources=[
                os.path.join(sdk["path"], "common", "network_connection.proto"),
                os.path.join(sdk["path"], "common", "valveextensions.proto"),
                os.path.join(sdk["path"], "common", "networkbasetypes.proto"),
                os.path.join(sdk["path"], "common", "source2_steam_stats.proto"),
                os.path.join(sdk["path"], "common", "netmessages.proto"),
            ],
        )
    ]

    nodes = builder.Add(binary)
    MMSPlugin.binaries += [nodes]
